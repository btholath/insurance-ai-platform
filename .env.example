# Copy this file to .env and fill in real values for your local environment.
# Never commit .env itself.

# Django
SECRET_KEY=changeme-generate-a-real-random-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL
POSTGRES_DB=insurance_ai_platform
POSTGRES_USER=insurance_ai_platform
POSTGRES_PASSWORD=changeme
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Optional: bootstrap a superuser on entrypoint boot.
# Left commented out on purpose — uncommenting is what opts you in. Without
# DJANGO_SUPERUSER_PASSWORD set, no account is created. Idempotent: skipped if
# the email already exists. Plaintext password, so local development only.
# DJANGO_SUPERUSER_EMAIL=
# DJANGO_SUPERUSER_PASSWORD=
# DJANGO_SUPERUSER_ROLE=system_administrator

# Redis
REDIS_URL=redis://redis:6379/0
